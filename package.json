{
  "name": "shukan-city-explorer",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "vite preview --host 127.0.0.1",
    "test": "node --test tests/metrics.test.mjs demo/demo.test.mjs",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "test:competition": "node --test --test-concurrency=1 tests/*.test.mjs scripts/pipeline/*.test.mjs",
    "validate:competition-data": "node scripts/pipeline/validate.mjs && node scripts/pipeline/validate-models.mjs",
    "dev:competition": "concurrently -k -n api,web \"node --watch server/index.mjs\" \"vite --host 127.0.0.1\""
  },
  "dependencies": {
    "3d-tiles-renderer": "0.5.3",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "maplibre-gl": "^6.11.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.1.2",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright-core": "1.63.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
